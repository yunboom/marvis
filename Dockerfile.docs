# Docs site image. Mirrors Dockerfile.web; keep the Node pin and the openssl
# floor in step with it.

# --- Dependencies ---
FROM node:22.23.4-alpine AS deps

WORKDIR /app

# Copy workspace config and the package.json files the docs app resolves
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json .npmrc ./
COPY apps/docs/package.json apps/docs/
# postinstall runs fumadocs-mdx which reads apps/docs/source.config.ts
COPY apps/docs/source.config.ts apps/docs/source.config.ts
# Root pnpm patchedDependencies is read even without the mobile workspace.
COPY apps/mobile/patches/ apps/mobile/patches/
COPY packages/ui/package.json packages/ui/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/

RUN corepack enable && \
    PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" && \
    corepack prepare "$PNPM_VERSION" --activate
RUN pnpm install --frozen-lockfile

# --- Build ---
FROM node:22.23.4-alpine AS builder

WORKDIR /app

COPY package.json ./
RUN corepack enable && \
    PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" && \
    corepack prepare "$PNPM_VERSION" --activate

# Copy installed dependencies (preserves pnpm symlink structure)
COPY --from=deps /app ./

# Copy source
COPY package.json turbo.json pnpm-workspace.yaml ./
COPY apps/docs/ apps/docs/
COPY packages/ packages/

# Re-link after source overlay; also regenerates the fumadocs .source index
RUN pnpm install --frozen-lockfile --offline

# Deployment path prefix, baked into Next's basePath (docs serve at
# `${NEXT_PUBLIC_BASE_PATH}/docs`). Empty serves them at /docs.
ARG NEXT_PUBLIC_BASE_PATH=
ENV NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH
ENV STANDALONE=true

RUN pnpm --filter @marvis/docs build

# --- Runtime ---
FROM node:22.23.4-alpine AS runner

WORKDIR /app

RUN apk add --no-cache "libcrypto3>=3.5.8-r0" "libssl3>=3.5.8-r0"

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/.next/static ./apps/docs/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/public ./apps/docs/public
# lib/site.ts checks which locales a page exists in by reading the MDX sources
# at request time, so the content tree ships with the server.
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/content ./apps/docs/content
COPY --chown=nextjs:nodejs LICENSE NOTICE ./

USER nextjs

EXPOSE 4000
ENV PORT=4000
ENV HOSTNAME=0.0.0.0

CMD ["node", "apps/docs/server.js"]
