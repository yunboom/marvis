# Marvis 生产环境配置模板（prototype 实例，https://omniai.shoplazza.site/marvis）
#
# 首次执行 make deploy-prod 时，脚本把它复制为本地主工作区根目录的 .env.prod（已被 git 忽略），
# 并把 __GENERATE_*__ 占位符替换成随机生成的密钥。之后只改本地的 .env.prod，
# 每次部署都会把它上传为服务器的 /root/apps/marvis/.env，旧版本保存在 /root/apps/marvis/env-backups/。
# 后端变量改完重新部署即可生效，不需要重新构建镜像。
# 这份模板会提交到仓库，不要在这里填写真实密钥。
#
# 没有出现在这里的变量使用 docker-compose.selfhost.yml 的默认值，完整说明见仓库根目录 .env.example。

# ==================== 端口与网络 ====================

# 容器端口在宿主机上绑定的地址。nginx 跑在容器里，经 host.docker.internal（即 docker0 网关）访问宿主机，
# 所以绑定到 docker0 网关而不是 127.0.0.1；不要改成 0.0.0.0，否则端口会绕过防火墙直接暴露到公网
MARVIS_BIND_ADDRESS=172.17.0.1
# 后端 API 在宿主机上的端口，nginx 的 /marvis/ws 直连这个端口
PORT=13840
# 网页端在宿主机上的端口，nginx 的 /marvis/ 转发到这个端口；容器内固定是 3000，这里只改宿主机端口
FRONTEND_PORT=13841
# 文档站在宿主机上的端口，nginx 的 /marvis/docs 转发到这个端口；容器内固定是 4000，这里只改宿主机端口
DOCS_PORT=13842

# ==================== 对外地址 ====================

# 浏览器访问的源（协议 + 域名，不带路径），用于后端校验 WebSocket 来源和跨域
FRONTEND_ORIGIN=https://omniai.shoplazza.site
# 允许跨域和建立 WebSocket 的来源，逗号分隔；同域部署与 FRONTEND_ORIGIN 一致
CORS_ALLOWED_ORIGINS=https://omniai.shoplazza.site
# 网页端的协议 + 域名，不带路径；后端拼邮件、飞书卡片等链接时自动加上镜像里的路径前缀（prod-images.yml 的 BASE_PATH）
MARVIS_APP_URL=https://omniai.shoplazza.site
# 后端对公网的完整地址，用于生成自动化 webhook、附件地址和网页上显示的 daemon 连接命令；
# 后端经 nginx 的 /marvis 转发，所以要带前缀，改前缀时这里和 nginx 一起改
MARVIS_PUBLIC_URL=https://omniai.shoplazza.site/marvis
# 允许设置 X-Forwarded-For / X-Real-IP 的代理网段，webhook 限流据此取真实客户端 IP；
# 172.16.0.0/12 覆盖本机所有 docker 网络（nginx 容器和网页端容器都在其中）
MARVIS_TRUSTED_PROXIES=172.16.0.0/12

# ==================== 网页端（路径前缀在 .github/workflows/prod-images.yml 的 BASE_PATH 里配置，构建时写进镜像） ====================

# 网页端容器转发 /api、/auth、/uploads 等请求的后端地址（compose 内部网络地址，不要改）
REMOTE_API_URL=http://backend:13840
# 网页端转发 /marvis/docs 的文档站地址（compose 内部网络地址）；nginx 也会直接把 /marvis/docs 转给文档站
DOCS_URL=http://docs:4000
# 浏览器调用后端的地址；留空表示同域，由网页端按 /marvis 前缀自动推导
NEXT_PUBLIC_API_URL=
# 浏览器连接 WebSocket 的地址；留空表示由上面的 API 地址推导为 wss://…/marvis/ws
NEXT_PUBLIC_WS_URL=

# ==================== 安全 ====================

# 运行环境；production 下拒绝弱密钥，并忽略开发用的固定验证码
APP_ENV=production
# 登录凭证（JWT）、daemon 凭证和附件链接签名的密钥；创建 .env.prod 时自动生成，修改后所有人需要重新登录
JWT_SECRET=__GENERATE_HEX32__
# 登录 Cookie 的域名；留空表示只对当前域名生效，同一域名下的其他子域拿不到登录态
COOKIE_DOMAIN=

# ==================== 数据库 ====================

# PostgreSQL 数据库名，数据保存在 docker 数据卷 marvis_pgdata
POSTGRES_DB=marvis
# PostgreSQL 用户名
POSTGRES_USER=marvis
# PostgreSQL 密码；创建 .env.prod 时自动生成。数据卷初始化后再修改不会改变数据库里的实际密码
POSTGRES_PASSWORD=__GENERATE_HEX24__

# ==================== 注册与权限 ====================

# 是否允许新用户注册；false 时只有白名单邮箱、白名单域名和收到邀请的人能注册
ALLOW_SIGNUP=true
# 不需要邀请即可注册的邮箱域名，逗号分隔，例如 shoplazza.com；留空表示不按域名放行
ALLOWED_EMAIL_DOMAINS=
# 不需要邀请即可注册的邮箱，逗号分隔
ALLOWED_EMAILS=
# 设为 true 后普通用户不能新建工作区
DISABLE_WORKSPACE_CREATION=
# DISABLE_WORKSPACE_CREATION=true 时，仍然可以新建工作区的邮箱，逗号分隔
WORKSPACE_CREATION_ALLOWED_EMAILS=

# ==================== 飞书登录 ====================

# 飞书开放平台应用的 App ID，填写后登录页显示飞书登录按钮；
# 需要在飞书后台把 https://omniai.shoplazza.site/marvis/auth/callback 登记为重定向地址
MARVIS_LARK_LOGIN_APP_ID=
# 飞书开放平台应用的 App Secret
MARVIS_LARK_LOGIN_APP_SECRET=
# 允许登录的飞书租户 tenant_key，逗号分隔；留空表示任何租户的飞书账号都能登录
MARVIS_LARK_LOGIN_TENANT_KEYS=

# ==================== 邮箱验证码登录（不用可留空） ====================

# Resend 的 API Key；生产环境下邮箱验证码只能通过 Resend 或下面的 SMTP 发出
RESEND_API_KEY=
# Resend 发件地址，域名需要在 Resend 后台验证
RESEND_FROM_EMAIL=
# SMTP 服务器地址；填写后优先于 Resend 使用
SMTP_HOST=
# SMTP 端口，常见为 465（TLS）或 587（STARTTLS）
SMTP_PORT=465
# SMTP 用户名
SMTP_USERNAME=
# SMTP 密码或授权码
SMTP_PASSWORD=
# 验证码邮件的发件地址
SMTP_FROM_EMAIL=

# ==================== 集成加密密钥 ====================

# 代码仓库集成（GitLab / Gitea / Forgejo）访问令牌的加密密钥；创建 .env.prod 时自动生成，生成后不要修改，否则已保存的令牌无法解密
MARVIS_VCS_SECRET_KEY=__GENERATE_B64_32__
# 飞书机器人集成的加密密钥；填写后才能在工作区设置里接入飞书机器人，用 openssl rand -base64 32 生成，生成后不要修改
MARVIS_LARK_SECRET_KEY=
# 是否由本部署处理飞书邀请卡片的按钮点击；同一个飞书应用只能有一个部署开启
MARVIS_LARK_INVITE_ENABLED=

# ==================== 大模型（不用可留空） ====================

# 服务端大模型的 API Key，用于会话标题生成等内部功能；与 BASE_URL 都留空时这些功能自动关闭
MARVIS_LLM_API_KEY=
# 服务端大模型的 OpenAI 兼容接口地址
MARVIS_LLM_BASE_URL=
# 服务端大模型默认使用的模型名
MARVIS_LLM_DEFAULT_MODEL=
# 知识库向量检索用的 embedding 接口地址（OpenAI 兼容，需返回 1024 维向量）；三项都填才启用向量检索，否则只用关键词检索
MARVIS_EMBEDDING_BASE_URL=
# embedding 接口的 API Key
MARVIS_EMBEDDING_API_KEY=
# embedding 模型名
MARVIS_EMBEDDING_MODEL=
